# Copy to .env.local. Never commit credentials.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAILS=
SITE_URL=https://www.beararmsarmorypa.com
# Keep false for client review/staging. Enable only on the approved production site.
SITE_INDEXABLE=false
# Exact hostname of an approved HTTPS image library. No scheme or slash.
IMAGE_HOST=
# Free Cloudinary Image & Video API account. All three are server-only.
# Cloud name also allows existing images to render; keep it after a provider switch.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set these only when running the one-time local account creation script.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
